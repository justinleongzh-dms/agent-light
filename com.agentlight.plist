<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts Agent Light when you log in. Replace YOUR_NAME with your Mac username. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentlight</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_NAME/.claude/agent-light/AgentLight</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
